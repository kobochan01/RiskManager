{
  "name": "risk-manager",
  "version": "1.1.1",
  "description": "保育園向けヒヤリハット事案管理アプリ",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "SET ELECTRON_RUN_AS_NODE=&& electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "postinstall": ""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.60.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.12.0"
  },
  "build": {
    "appId": "com.kobochan.riskmanager",
    "productName": "RiskManager",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  }
}
